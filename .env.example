# Copy this file to .env.local and fill in the values from the Supabase dashboard
# (Project Settings > API Keys). .env.local is git-ignored; never commit real values.
# Only the publishable key goes here, never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
