# Copy this file to .env.local and fill in the values of the TEST Supabase project
# (fotocopias-upb-dev > Project Settings > API Keys); production values live only in Vercel.
# .env.local is git-ignored; never commit real values.
# Only the publishable key goes here, never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
